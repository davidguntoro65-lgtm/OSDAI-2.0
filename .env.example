# =============================================================
# OSDAI — Otomatisasi Sekolah Digital Berbasis AI
# Environment Configuration Template
# Copy this file to .env and fill in the values.
# =============================================================

# ------------------------------------------------------------
# APPLICATION
# PENTING: Isi APP_URL dengan domain produksi Anda (tanpa trailing slash)
# ------------------------------------------------------------
APP_NAME="OSDAI"
APP_ENV=production
# Full URL domain produksi (tanpa trailing slash)
APP_URL=https://osdai.smkn1wonogiri.sch.id
# Jangan set APP_PORT di cPanel — biarkan Passenger yang mengaturnya
# APP_PORT=5000

# ------------------------------------------------------------
# DATABASE
# Format cPanel: postgresql://USER:PASS@127.0.0.1:5432/DBNAME?sslmode=disable
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname?sslmode=disable

# ------------------------------------------------------------
# AUTHENTICATION
# Gunakan string acak minimal 64 karakter untuk keamanan maksimal
# ------------------------------------------------------------
JWT_SECRET=isi_dengan_string_acak_panjang_minimal_64_karakter
JWT_REFRESH_SECRET=isi_dengan_string_acak_lain_minimal_64_karakter

# ------------------------------------------------------------
# AI INTEGRATION
# Gunakan Gemini API key dari https://aistudio.google.com/apikey
# (Di Replit: dikonfigurasi otomatis, tidak perlu isi)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# EMAIL / OTP
# Pilih: smtp | resend
# ------------------------------------------------------------
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# Resend (alternatif SMTP)
RESEND_API_KEY=

# ------------------------------------------------------------
# PAYMENT — Midtrans
# Set MIDTRANS_IS_PRODUCTION=true saat go-live
# ------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------
# FILE STORAGE
# Biarkan local untuk upload di server sendiri
# ------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# QR / REPORTS
# Ganti dengan string acak yang aman
# ------------------------------------------------------------
QR_SECRET=ganti_dengan_string_acak_aman

# ------------------------------------------------------------
# MAPS (GPS attendance — opsional)
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------
# SECURITY
# CORS_ORIGINS: domain yang diizinkan, pisahkan dengan koma
# ------------------------------------------------------------
CORS_ORIGINS=https://osdai.smkn1wonogiri.sch.id
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
